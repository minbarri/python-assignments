        "# 사용자로부터 숫자 입력 받기\n",
        "num_str = input(\"숫자를 입력하세요: \")\n",
        "\n",
        "# 입력값이 숫자인지 확인\n",
        "if num_str.isdigit():\n",
        "    num = int(num_str)\n",
        "\n",
        "    if num % 2 == 0:\n",
        "        print(f\"{num}은(는) 짝수입니다. ✅\")\n",
        "    elif num % 2 == 1:\n",
        "        print(f\"{num}은(는) 홀수입니다. 🟡\")\n",
        "    else:\n",
        "        print(\"예상치 못한 경우입니다.\")\n",
        "else:\n",
        "    print(\"숫자가 아닙니다. 숫자만 입력해주세요. 🚫\")"
      ]
    }
